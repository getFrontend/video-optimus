{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Video Optimus",
  "version": "1.2.4",
  "identifier": "local.video-optimus.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Video Optimus - розумна оптимізація відео",
        "width": 1360,
        "height": 900,
        "minWidth": 980,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; media-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/previews/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "category": "Utility",
    "shortDescription": "Локальное сжатие видео",
    "longDescription": "Приложение для локального анализа и последовательной оптимизации видео."
  }
}
